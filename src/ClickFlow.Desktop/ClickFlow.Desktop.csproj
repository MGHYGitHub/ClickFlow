<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <AssemblyName>ClickFlow</AssemblyName><RootNamespace>ClickFlow.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ClickFlow.ico</ApplicationIcon>
    <Description>ClickFlow 自动点击器</Description><Authors>MGHYGitHub</Authors>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ClickFlow.Core/ClickFlow.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/ClickFlow.ico" /></ItemGroup>
</Project>
